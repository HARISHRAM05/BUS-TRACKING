# Copy this file to .env and fill in your own values.
# When hosting, set these in the host's dashboard instead (never commit a real .env), and also set NODE_ENV=production.
# Use a long random JWT_SECRET and your own ADMIN_SIGNUP_CODE - the values below are only examples.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/karunya_bus_portal
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Secret code required to sign up as an Admin (share only with the Transport Office)
ADMIN_SIGNUP_CODE=KARUNYA-TRANSPORT-2026
# Demo map: move buses along their routes (set to false once real GPS trackers report positions)
SIMULATE_BUS_TRACKING=true
# Login/sign-up brute-force protection: max FAILED attempts per IP per window (minutes)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173
